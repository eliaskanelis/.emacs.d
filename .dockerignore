# Ignore git repository
.git/
.gitignore

# Ignore Dockerignore file itself
.dockerignore

# Ignore CI configuration files (if not needed in the image)
.drone.yml

# Ignore license, readme, and makefile (if not required in the image)
LICENSE
README.md
Makefile

# Ignore byte-compiled output: Emacs loads init/early-init without an
# extension and `load-prefer-newer' is nil, so a stale .elc would shadow the .el
# baked into the image.
**/*.elc
